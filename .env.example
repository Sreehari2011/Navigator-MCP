# ============================================================================
# Navigator MCP — configuration
# Copy to your environment / .env and adjust. Everything is optional.
# ============================================================================

# --- browser ---------------------------------------------------------------
NAVIGATOR_HEADLESS=true            # false for captcha-manual / debugging / VNC
NAVIGATOR_BROWSER_CHANNEL=chromium # or: chrome, msedge (uses installed browser)
NAVIGATOR_VIEWPORT_WIDTH=1440
NAVIGATOR_VIEWPORT_HEIGHT=900
NAVIGATOR_NAV_TIMEOUT_MS=30000
NAVIGATOR_ACTION_TIMEOUT_MS=10000
NAVIGATOR_AUTO_SNAPSHOT=true       # include snapshot in action results when changed
# Connect to an external (patched / anti-detect) browser instead of launching:
# NAVIGATOR_CDP_ENDPOINT=ws://127.0.0.1:9222/playwright
# Default proxy for all sessions:
# NAVIGATOR_PROXY_SERVER=http://user:pass@proxy-host:8080

# --- stealth ------------------------------------------------------------------
NAVIGATOR_STEALTH=true             # fingerprints + runtime patches
NAVIGATOR_HUMANIZE=true            # human-like mouse paths + typing jitter

# --- captcha (BYO keys) ----------------------------------------------------------
# TWOCAPTCHA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# CAPSOLVER_API_KEY=CAP-xxxxxxxxxxxxxxxxxxxx

# --- navigation lockdown (optional) ------------------------------------------------
# Pin the browser to an allowlist of domains (keep agents on-task):
# NAVIGATOR_ALLOWED_DOMAINS=docs.python.org,*.internal.test

# --- remote access (optional) -----------------------------------------------------------------
# NAVIGATOR_API_KEYS=sk-my-laptop,sk-my-desktop  # require keys on the HTTP transport
NAVIGATOR_HTTP_HOST=127.0.0.1
NAVIGATOR_HTTP_PORT=8765

# --- local usage stats (never leaves this machine) --------------------------------------------
NAVIGATOR_STATS=true
# Resource sanity cap for parallel browser sessions (not a licensing limit):
# NAVIGATOR_MAX_SESSIONS=64
